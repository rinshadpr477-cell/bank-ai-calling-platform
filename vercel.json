{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "bank-ai-calling": {
      "root": "bank-ai-calling",
      "framework": "nextjs",
      "buildCommand": "npx prisma generate && next build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "bank-ai-calling"
      }
    }
  ]
}
